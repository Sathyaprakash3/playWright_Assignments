pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t playwright-framework .'
            }
        }

        stage('Run Playwright Tests') {
            steps {
                bat 'docker run -v %cd%\\dockerReports:/app/playwright-report playwright-framework'
            }
        }

        stage('Archive Playwright Reports') {
            steps {
                archiveArtifacts artifacts: 'dockerReports/**/*', fingerprint: true
            }
        }
    }

    post {

        always {

            emailext (
                subject: "Build ${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                body: """
                Build Status: ${currentBuild.currentResult}
                Project: ${env.JOB_NAME}
                Build Number: ${env.BUILD_NUMBER}
                URL: ${env.BUILD_URL}
                """,
                to: "sathyaprakash31997@gmail.com",
                attachmentsPattern: 'dockerReports/index.html',
                attachLog: true
            )

            echo "Build Completed"
        }

        success {
            echo "Tests Passed"
        }

        failure {
            echo "Tests Failed"
        }
    }
}