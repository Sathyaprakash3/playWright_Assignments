pipeline {
    agent any

    stages {

        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Images') {
            steps {
                bat 'docker compose build'
            }
        }

        stage('Parallel Test Execution') {

            parallel {

                stage('Smoke Tests') {
                    steps {
                        bat 'docker compose run --rm smoke'
                    }
                }

                stage('Regression Tests') {
                    steps {
                        bat 'docker compose run --rm regression'
                    }
                }

                stage('API Tests') {
                    steps {
                        bat 'docker compose run --rm api'
                    }
                }
            }
        }

        stage('Archive Playwright Reports') {
            steps {
                archiveArtifacts artifacts: 'reports/**/*', fingerprint: true
            }
        }
    }

    post {

        always {

            bat 'docker compose down'

            emailext (
                subject: "Build ${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                body: """
                Build Status: ${currentBuild.currentResult}

                Project: ${env.JOB_NAME}

                Build Number: ${env.BUILD_NUMBER}

                Build URL: ${env.BUILD_URL}
                """,
                to: "sathyaprakash31997@gmail.com",
                attachmentsPattern: 'playwright-report/index.html',
                attachLog: true
            )

            echo "Build Completed"
        }

        success {
            echo "Tests Passed Successfully"
        }

        failure {
            echo "Tests Failed"
        }
    }
}